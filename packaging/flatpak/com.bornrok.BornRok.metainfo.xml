<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.bornrok.BornRok</id>
  <name>BornRok</name>
  <summary>Classic sprite-based MMORPG</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>
  <developer id="com.bornrok">
    <name>PechSoft</name>
  </developer>
  <description>
    <p>
      BornRok is a cross-platform client for a classic Ragnarok-style MMORPG. It renders the
      original 2D sprite world with a modern engine and downloads game content through its
      built-in patcher.
    </p>
    <p>Features:</p>
    <ul>
      <li>Classic 2D sprite rendering with modern lighting and effects</li>
      <li>Full character, inventory, skill, party, guild and trade systems</li>
      <li>Gamepad and touch input support</li>
      <li>Built-in patcher keeps game content up to date</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.bornrok.BornRok.desktop</launchable>
  <categories>
    <category>Game</category>
    <category>RolePlaying</category>
  </categories>
