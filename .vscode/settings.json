{
  // Use the presets from CMakePresets.json (win-msvc / linux-gcc / core-only).
  "cmake.useCMakePresets": "always",

  // The CMake project root is this folder (open the `Client` folder in VS Code).
  // If you open the uAthena repo root instead, change this to
  //   "${workspaceFolder}/Client"
  "cmake.sourceDirectory": "${workspaceFolder}",
  "cmake.configureOnOpen": true,

  // Let CMake Tools drive IntelliSense (include paths, defines, C++20).
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "C_Cpp.default.cppStandard": "c++20",

  "files.associations": {
    "*.sc": "glsl",
    "*.def.sc": "glsl",
    "*.hpp": "cpp"
  }
}
