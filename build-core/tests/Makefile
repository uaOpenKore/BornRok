test_zip.cpp.s:
	cd /root/uAthena/Client/build-core && $(MAKE) $(MAKESILENT) -f tests/CMakeFiles/client_core_tests.dir/build.make tests/CMakeFiles/client_core_tests.dir/test_zip.cpp.s
.PHONY : test_zip.cpp.s

